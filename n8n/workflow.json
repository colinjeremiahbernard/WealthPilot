      },
      "id": "19f4052a-00fd-4fab-8caf-73f282c15dcd",
      "name": "Webhook - Receive Clients",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "investment-assistant"
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/colinjeremiahbernard/WealthPilot/main/docs/data.csv",
        "options": {}
      },
      "id": "35c87186-21c1-444d-9ef7-ddb96517355e",
      "name": "Fetch Investment Options (CSV)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        208
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const csvText = $input.first().json.data || $input.first().binary?.data;\nconst raw = typeof csvText === 'string' ? csvText : $input.first().json.toString();\n\nconst lines = raw.trim().split('\\n');\nconst headers = lines[0].split(',');\n\nconst options = lines.slice(1).map(line => {\n  const cols = line.split(',');\n  const row = {};\n  headers.forEach((h, i) => row[h.trim()] = (cols[i] || '').trim());\n  return row;\n});\n\nreturn [{ json: { options } }];"
      },
      "id": "6e151682-8f17-4fdf-a869-b2ff407bec10",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "clients",
        "options": {}
      },
      "id": "2a5df5a9-c64e-4a94-93de-fb9a8c8421e4",
      "name": "Split Out Clients",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawInput = $input.first();\nlet rawCsv = \"\";\nif (typeof rawInput.json.data === \"string\") {\n  rawCsv = rawInput.json.data;\n} else if (typeof rawInput.json === \"string\") {\n  rawCsv = rawInput.json;\n} else if (rawInput.binary?.data) {\n  rawCsv = rawInput.binary.data;\n} else {\n  rawCsv = JSON.stringify(rawInput.json);\n}\n\nconst lines = rawCsv.trim().split(/\\r?\\n/);\nconst headers = lines[0].split(\",\").map(h => h.trim());\nconst options = lines.slice(1).map(line => {\n  const cols = line.split(\",\");\n  const row = {};\n  headers.forEach((h, i) => row[h] = (cols[i] || \"\").trim());\n  return row;\n});\n\nconst webhookJson = $('Webhook - Receive Clients').first().json;\nconst clients = webhookJson.body?.clients || webhookJson.clients || [];\n\nreturn clients.map(client => {\n  const matches = options.filter(o => o.profile === client.profile);\n  return {\n    json: {\n      ...client,\n      matched_options: matches\n    }\n  };\n});"
      },
      "id": "34f87d86-d005-457d-a762-c0b32587f1f5",
      "name": "Match Profile to Options",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $env.USE_AI_MESSAGES }}",
              "rightValue": "never",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1738b982-f01c-40ff-90c0-a989e112ebf0",
      "name": "Use AI Messages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 300,\n  messages: [{\n    role: \"user\",\n    content: `Escreva uma mensagem curta e personalizada (em portugues, tom consultivo e amigavel) recomendando investimentos para ${$json.name}, perfil ${$json.profile}, saldo R$ ${$json.balance}. Opcoes disponiveis: ${JSON.stringify($json.matched_options)}. Nao invente numeros fora das opcoes fornecidas.`\n  }]\n} }}",
        "options": {}
      },
      "id": "b97819f3-3efa-4e42-8d89-ecd9ed0df26b",
      "name": "AI Agent - Generate Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "anthropicApi": {
          "id": "nCtpe10LIml2ypXZ",
          "name": "Anthropic account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const matchItems = $('Match Profile to Options').all();\nreturn $input.all().map((inputItem, index) => {\n  const item = matchItems[index]?.json || {};\n  const text = inputItem.json.content?.[0]?.text;\n  if (text) {\n    return { json: { ...item, message: text, source: \"ai\" } };\n  }\n  const templates = {\n    \"Conservador\": `Ola ${item.name}, para o seu perfil conservador recomendamos foco em renda fixa de baixo risco, como ${item.matched_options?.[0]?.option}.`,\n    \"Moderado\": `Ola ${item.name}, para o seu perfil moderado sugerimos um mix equilibrado, como ${item.matched_options?.[0]?.option}.`,\n    \"Arrojado\": `Ola ${item.name}, para o seu perfil arrojado indicamos maior exposicao a renda variavel, como ${item.matched_options?.[0]?.option}.`\n  };\n  return { json: { ...item, message: templates[item.profile] || \"Recomendacao indisponivel.\", source: \"static-fallback\" } };\n});"
      },
      "id": "f45151b8-5c39-47fc-810b-3723e375d2dc",
      "name": "Extract AI Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const templates = {\n  'Conservador': (name, opt) => `Ola ${name}, para o seu perfil conservador recomendamos foco em renda fixa de baixo risco, como ${opt}.`,\n  'Moderado': (name, opt) => `Ola ${name}, para o seu perfil moderado sugerimos um mix equilibrado, como ${opt}.`,\n  'Arrojado': (name, opt) => `Ola ${name}, para o seu perfil arrojado indicamos maior exposicao a renda variavel, como ${opt}.`\n};\n\nreturn $input.all().map(item => {\n  const json = item.json;\n  const opt = json.matched_options?.[0]?.option || 'opcoes disponiveis';\n  const fn = templates[json.profile] || templates['Conservador'];\n  return {\n    json: {\n      ...json,\n      message: fn(json.name, opt),\n      source: 'static'\n    }\n  };\n});"
      },
