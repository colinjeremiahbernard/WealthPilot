# URL of the n8n Webhook trigger node.
# Use webhook-test/... while testing in n8n (workflow not activated).
# Use webhook/... when the workflow is activated for production.
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/investment-assistant

# Set to "true" to route through the AI branch instead of static templates.
# Requires ANTHROPIC_API_KEY to be set in your n8n environment variables.
# USE_AI_MESSAGES=true

# Your Anthropic API key — set this in n8n's environment variables, not here.
# ANTHROPIC_API_KEY=sk-ant-...
